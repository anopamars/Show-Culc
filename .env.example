# Copy this file to .env.local and populate with your Supabase project values

SHOWCULC_SUPABASE_URL=https://your-project.supabase.co
SHOWCULC_SUPABASE_ANON_KEY=your-public-anon-key
SHOWCULC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SHOWCULC_SUPABASE_JWT_SECRET=your-jwt-secret
SHOWCULC_SUPABASE_SECRET_KEY=your-secret-key
SHOWCULC_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SHOWCULC_POSTGRES_DATABASE=postgres
SHOWCULC_POSTGRES_HOST=db.your-project.supabase.co
SHOWCULC_POSTGRES_USER=postgres
SHOWCULC_POSTGRES_PASSWORD=your-postgres-password
SHOWCULC_POSTGRES_PRISMA_URL=postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
SHOWCULC_POSTGRES_URL=postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x
SHOWCULC_POSTGRES_URL_NON_POOLING=postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
